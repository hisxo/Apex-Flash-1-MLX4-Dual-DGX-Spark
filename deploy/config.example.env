# Copy to config.env on each node and adjust local paths and interface names.
IMAGE=apex-flash-tensorfold:0.6.4
CONTAINER_PREFIX=apex-flash-tf064

MODEL_DIR=/srv/models/apex-flash-1-mlx4
CACHE_DIR=/srv/tensorfold-cache
DRAFTER_DIR=none

# Address of rank 0 on the direct link between both nodes.
MASTER_ADDR=192.0.2.10
MASTER_PORT=29551
NCCL_SOCKET_IFNAME=eth1
GLOO_SOCKET_IFNAME=eth1
NCCL_IB_HCA=

API_HOST=127.0.0.1
API_PORT=8000
SERVED_MODEL=apex-flash-1-abliterated
CONTEXT=262144
MAX_TOKENS=32768
REASONING_EFFORT=high
PARALLEL=1
VISION=0
CUDA_VISIBLE_DEVICES=0
TF_GLM_MTP=1
