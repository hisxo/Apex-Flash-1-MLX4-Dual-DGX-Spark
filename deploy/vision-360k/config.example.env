# Experimental CUDA vision profile. Copy to ../config.env on both nodes.
IMAGE=apex-flash-tensorfold:vision-360k
CONTAINER_PREFIX=apex-flash-vision360

MODEL_DIR=/srv/models/apex-flash-1-mlx4
CACHE_DIR=/srv/tensorfold-vision360-cache
DRAFTER_DIR=/srv/models/GLM-5.3-Flash-DFlash2

# Address of rank 0 on the private link between both nodes.
MASTER_ADDR=192.0.2.10
MASTER_PORT=29551
NCCL_SOCKET_IFNAME=eth1
GLOO_SOCKET_IFNAME=eth1
NCCL_IB_HCA=

API_HOST=127.0.0.1
API_PORT=8000
SERVED_MODEL=apex-flash-1-abliterated
CONTEXT=360000
MAX_TOKENS=32768
REASONING_EFFORT=medium
PARALLEL=1
VISION=1
CUDA_VISIBLE_DEVICES=0

# Preserve BF16 latent/indexer caches. DFlash2 remains speculative while the
# checkpoint's MTP head is omitted to recover its resident memory.
TF_GLM_KV=bf16
TF_GLM_MTP=auto
TF_GLM_CACHE_GIB=0
TF_GLM_DRAFT_RING=1
TENSORFOLD_MEMORY_RESERVE_GIB=14.5

# Vision limits used for the qualified profile.
TENSORFOLD_GLM_IMAGE_TOKENS=2048
TENSORFOLD_GLM_MAX_IMAGES=8
TENSORFOLD_GLM_REQUEST_IMAGE_TOKENS=8192
